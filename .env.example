# Bản mẫu cho .env của Docker Compose (copy thành .env và điền giá trị thật — KHÔNG commit .env)
POSTGRES_DB=ulis
POSTGRES_USER=ulis
POSTGRES_PASSWORD=ulis

# JWT secret tối thiểu 32 ký tự (256-bit) cho HS256
JWT_SECRET=change-me-to-a-long-random-256bit-secret-key-in-prod

# SMTP Brevo (prod)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# CORS & Admin seed
CORS_ALLOWED_ORIGINS=http://localhost
ADMIN_EMAIL=admin@ulis.edu.vn
ADMIN_PASSWORD=Admin@123456
